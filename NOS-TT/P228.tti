OL,5,B20.25-21.10 uurB   VALS PARADIJS:KRACHT
OL,6,B                    GEBOREN UIT STRIJD 
OL,7,F                                       
OL,8,FIn Zuid-Afrika en Mauritius ontdekken  
OL,9,FFeroz Amirkhan en Pavan Marhe hoe het  
OL,10,Fverzet tegen contractarbeid uitgroeide 
OL,11,Ftot een internationale beweging.       
OL,12,G                                       
OL,13,FContractarbeid was het onderdrukkende  
OL,14,Fsysteem waarmee na de afschaffing van  
OL,15,Fde slavernij honderdduizenden          
OL,16,FHindostanen naar kolonien,waaronder    
OL,17,FSuriname,werden gebracht.              
OL,18,G                                       
OL,19,FDeze strijd van hun voorouders bracht  
OL,20,Fdit systeem ten val.Geschiedenis wordt 
OL,21,Fzo meer dan iets om te herdenken.      
OL,22,G     F                                 
