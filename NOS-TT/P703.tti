OL,4,T#######################################
OL,5,BZON, WOLKEN EN ENKELE BUIEN            
OL,6,F                                       
OL,7,FVandaag wisselen zon en wolken elkaar  
OL,8,Faf met verspreid een bui.In de middag  
OL,9,Fzijn er meer buien in het noorden dan  
OL,10,Fin het zuiden.Het wordt 8 tot 10 graden
OL,11,Fbij een zwakke tot matige westenwind.  
OL,12,F                                       
OL,13,FIn de avond zijn er brede opklaringen  
OL,14,Fen zakt het kwik snel naar het         
OL,15,Fvriespunt.In de nacht komt het op veel 
OL,16,Fplaatsen tot een graadje vorst.        
OL,17,F                                       
OL,18,FZondag wordt een droge dag met geregeld
OL,19,Fzon.De maxima komen uit tussen 5 en 8  
OL,20,Fgraden en er waait een zwakke tot      
OL,21,Fmatige noordoostenwind.                
OL,22,F                                       
