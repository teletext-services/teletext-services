OL,5,BNoord-Europa - woensdag                
OL,6,FHet is woensdag wisselend bewolkt en op
OL,7,Fde meeste plaatsen droog.In het noorden
OL,8,Fvan Noorwegen kan regionaal een beetje 
OL,9,Fwinterse neerslag vallen.In het zuiden 
OL,10,Fvan Noorwegen is het zonnig en ook in  
OL,11,FDenemarken en Centraal-Zweden is er    
OL,12,Fruimte voor de zon.                    
OL,13,F                                       
OL,14,BAlborg        FHalf bewolkt        2 C@
OL,15,BBergen        FZonnig              1 C@
OL,16,BHammerfest    FBewolkt             2 C@
OL,17,BHelsinki      FZonnig             -1 C@
OL,18,BKajaani       FHalf bewolkt       -5 C@
OL,19,BKiruna        FHalf bewolkt       -9 C@
OL,20,BKopenhagen    FZonnig              3 C@
OL,21,BOslo          FZonnig             -4 C@
OL,22,BStockholm     FHalf bewolkt        0 C@
