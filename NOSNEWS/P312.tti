OL,2,D] C]GKONINGSHUISD ]D                   
OL,3,S#######################################
OL,4,B30 Oct 2026 18:32:28                   
OL,6,CMan rent op koning af bij werkbezoek in
OL,7,CUrsem, beveiligers grijpen in          
OL,9,GBij een werkbezoek aan het             
OL,10,GNoord-Hollandse dorp Ursem is koning   
OL,11,GWillem-Alexander vanmiddag aangesproken
OL,12,Gdoor een mogelijk verwarde man. Dat    
OL,13,Ggebeurde toen de koning een            
OL,14,Gbrandweerkazerne had bezocht. Op       
OL,15,Gbeelden is te zien dat de man dicht bij
OL,16,Gde koning komt, maar door beveiligers  
OL,17,Gwordt tegengehouden.                   
OL,24,C]G                               (1/4) 
FL,0,0,0,0,0,100
PN,31202
SC,0002
