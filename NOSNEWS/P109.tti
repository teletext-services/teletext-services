OL,2,D]GNOS NIEUWS G]D        Laatste nieuws 
OL,3,T#######################################
OL,4,GTot alles in beweging komt is de       
OL,5,Gdebuutroman van Perquin, die eerder    
OL,6,Gcolumns schreef en dichtbundels        
OL,7,Guitbracht. Van 2017 tot 2019 was ze    
OL,8,GDichter des Vaderlands . Ook was ze    
OL,9,Gstadsdichter van Rotterdam. Haar       
OL,10,Ggedichten en bundels werden bekroond   
OL,11,Gmet poezieprijzen.                     
OL,24,D]GNOS Nieuws                     (2/5) 
FL,0,0,0,0,0,100
PN,10903
SC,0003
