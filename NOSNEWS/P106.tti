OL,2,D]GNOS NIEUWS G]D        Laatste nieuws 
OL,3,T#######################################
OL,4,F20 Nov 2026 12:31:49                   
OL,6,COM hackte Tata Steel in onderzoek naar 
OL,7,Cmogelijk opzettelijke vervuiling       
OL,8,Comgeving                               
OL,10,GHet Openbaar Ministerie heeft Tata     
OL,11,GSteel gehackt, als deel van een        
OL,12,Gstrafrechtelijk onderzoek naar het     
OL,13,Gbedrijf. Dat komt naar voren tijdens de
OL,14,Grechtszaak tegen het bedrijf uit       
OL,15,GIJmuiden die vandaag begon. Het OM     
OL,16,Gheeft het over het "heimelijk          
OL,17,Gbinnendringen van het bedrijfsnetwerk  
OL,18,Gvan Tata Steel".                       
OL,24,D]GNOS Nieuws                     (1/8) 
FL,0,0,0,0,0,100
PN,10602
SC,0002
PS,C200
CT,10,T
OL,0,       BNOS NIEUWS Cvri 20 nov  13:54:04
OL,1,Tppppppppppppppppppppppppppppppppppppppp
OL,2,D]GNOS NIEUWS G]D        Laatste nieuws 
OL,3,T#######################################
OL,4,GWat het Openbaar Ministerie precies    
OL,5,Gheeft aangetroffen tijdens het         
OL,6,Gonderzoek, wordt pas later tijdens de  
OL,7,Gbehandeling van de rechtszaak          
OL,8,Gduidelijk.                             
OL,10,GTata Steel wordt door het OM verdacht  
OL,11,Gvan 'opzettelijke vervuiling' door het 
OL,12,Gin de lucht brengen van schadelijke    
OL,13,Gstoffen. De rechtszaak tegen Tata Steel
OL,14,Gkomt na de aangifte van 1200 omwonenden
OL,15,Gvan de staalfabriek.                   
OL,24,D]GNOS Nieuws                     (2/8) 
FL,0,0,0,0,0,100
