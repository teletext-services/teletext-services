OL,3,T#######################################
OL,4,F20 Nov 2026 12:37:00                   
OL,6,C17 jaar cel geeist voor fatale         
OL,7,CMDMA-vergiftiging treinschoonmaker     
OL,9,GHet Openbaar Ministerie (OM) eist 17   
OL,10,Gjaar celstraf tegen de 38-jarige Fela  
OL,11,GD. Volgens justitie is hij             
OL,12,Gverantwoordelijk voor drie             
OL,13,Gvergiftigingen met vloeibare MDMA. Bij 
OL,14,Geen van die incidenten kwam een        
OL,15,G49-jarige treinschoonmaker om het      
OL,16,Gleven.                                 
OL,24,D]GNOS Nieuws                     (1/8) 
FL,0,0,0,0,0,100
