OL,3,T#######################################
OL,4,F20 Nov 2026 15:39:54                   
OL,6,CAI-bedrijf Anthropic daalt hard op dag 
OL,7,Cna historische beursgang               
OL,9,GEen dag nadat het de grootste beursgang
OL,10,Gooit beleefde, verliest AI-bedrijf     
OL,11,GAnthropic bij de opening van de beurs  
OL,12,Gzo'n 9 procent van zijn waarde.        
OL,13,GBeleggers hadden goede hoop dat de     
OL,14,Gbeursgang ook andere chipbedrijven     
OL,15,Gomhoog zou trekken, maar het           
OL,16,Gtegenovergestelde lijkt vandaag te     
OL,17,Ggebeuren.                              
OL,24,D]GNOS Nieuws                     (1/6) 
FL,0,0,0,0,0,100
