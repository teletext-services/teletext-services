OL,3,Q#######################################
OL,4,FLoting EK onder 21 in 2027             
OL,6,GGroep A: Servie, Polen, Engeland,      
OL,7,GFrankrijk                              
OL,9,GGroep B: Albanie, Spanje, Italie,      
OL,10,GFinland                                
OL,12,GGroep C: Tsjechie, Portugal,           
OL,13,GGriekenland, Kroatie                   
OL,15,GGroep D: Noorwegen, Belgie, Duitsland, 
OL,16,GNederland                              
