OL,0,       BNOS NIEUWS Czon 22 nov  17:53:32
OL,1,Tppppppppppppppppppppppppppppppppppppppp
OL,2,D]GNOS NIEUWS G]D        Laatste nieuws 
OL,3,T#######################################
OL,4,FGeelwangschildpadden                   
OL,6,GAfgelopen voorjaar kwam een luisteraar,
OL,7,GMarielle van den Berg, vier jonge      
OL,8,Gschildpadden tegen in de buurt van een 
OL,9,Gvijver in het Zuid-Hollandse dorp      
OL,10,GDirksland. Het bleek om                
OL,11,Ggeelwangschildpadden te gaan, een      
OL,12,Gondersoort van de waterschildpad.      
OL,14,GVia het radioprogramma kwam ze in      
OL,15,Gcontact met schildpaddenonderzoeker Tim
OL,16,GHuijsmans van Faunawatch, een          
OL,17,Gdierenorganisatie die zich inzet voor  
OL,18,Ggedumpte en verwaarloosde schildpadden.
OL,24,D]GNOS Nieuws                     (2/7) 
FL,0,0,0,0,0,100
PN,11703
SC,0003
PS,C200
CT,15,T
OL,0,       BNOS NIEUWS Czon 22 nov  17:53:32
OL,1,Tppppppppppppppppppppppppppppppppppppppp
OL,2,D]GNOS NIEUWS G]D        Laatste nieuws 
OL,3,T#######################################
OL,4,GNa overleg met de schildpadonderzoeker 
OL,5,Gging Van den Berg kijken bij de plek   
OL,6,Gwaar ze de jonge schildpadden had      
OL,7,Ggezien. Daar trof ze zestien lege      
OL,8,Geieren en twee jonge schildpadjes aan. 
OL,9,GZe nam de dieren en eieren mee voor    
OL,10,GHuijsmans.                             
OL,12,GDe schildpaddenonderzoeker legde de    
OL,13,Gvondst vast in een wetenschappelijke   
OL,14,Gpublicatie. Inmiddels zijn de twee     
OL,15,Ggevonden schildpadjes naar de          
OL,16,Gschildpaddenopvang in Limburg gebracht.
OL,24,D]GNOS Nieuws                     (3/7) 
FL,0,0,0,0,0,100
