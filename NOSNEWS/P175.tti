OL,2,D]GNOS NIEUWS G]D            Buitenland 
OL,3,T#######################################
OL,4,F26 Nov 2026 14:15:32                   
OL,6,CTwee Irakezen opgepakt in Duitsland    
OL,7,Cvoor voorbereiden terroristische       
OL,8,Caanslagen                              
OL,10,GIn Duitsland zijn twee Irakese mannen  
OL,11,Gvan 31 en 34 jaar oud opgepakt op      
OL,12,Gverdenking van het plannen van meerdere
OL,13,Gterreuraanslagen, waaronder op een     
OL,14,Gsynagoge in Keulen. De mannen maken    
OL,15,Gvolgens de Duitse autoriteiten deel uit
OL,16,Gvan een pro-Iraanse terroristische     
OL,17,Gorganisatie en zouden ook aanslagen    
OL,18,Ghebben willen plegen op doelen elders  
OL,19,Gin Europa.                             
OL,24,D]GNOS Nieuws                     (1/5) 
FL,0,0,0,0,0,100
PN,17502
SC,0002
PS,C200
CT,15,T
OL,0,       BNOS NIEUWS Cvri 27 nov  11:56:13
OL,1,Tppppppppppppppppppppppppppppppppppppppp
OL,2,D]GNOS NIEUWS G]D            Buitenland 
OL,3,T#######################################
OL,4,GDe arrestaties waren in de steden      
OL,5,GHeidelberg en Keulen. De Duitse        
OL,6,Gjustitie meldt daarnaast dat zeventien 
OL,7,Ghuis- en panddoorzoekingen zijn gedaan 
OL,8,Gin de deelstaten Baden-W}rttemberg,    
OL,9,GNoordrijn-Westfalen en Hessen. Er is   
OL,10,Gvolgens het Openbaar Ministerie nog een
OL,11,Gextra verdachte in beeld.              
OL,24,D]GNOS Nieuws                     (2/5) 
FL,0,0,0,0,0,100
