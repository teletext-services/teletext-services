SC,0011
PS,C200
CT,10,T
OL,0,       BNOS NIEUWS Czat 21 nov  09:56:48
OL,1,Tppppppppppppppppppppppppppppppppppppppp
OL,2,D]GNOS NIEUWS G]D              Economie 
OL,3,T#######################################
OL,4,FKabinet praat verder over steun aan    
OL,5,FTata                                   
OL,7,GHet kabinet heeft laten weten dat de   
OL,8,Gonderhandelingen met Tata over         
OL,9,Gverduurzaming doorgaan ondanks deze    
OL,10,Gstrafzaak. Toch lijkt het Ficq "niet   
OL,11,Gwaarschijnlijk" dat de overheid het    
OL,12,Ggeld overmaakt voordat de rechter een  
OL,13,Guitspraak heeft gedaan.                
OL,24,D]GNOS Nieuws                   (11/12) 
FL,0,0,0,0,0,100
PN,23412
SC,0012
