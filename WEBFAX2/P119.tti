OL,1,W5j 5Q7+j 55"k#j 5w;js1           
OL,2,W//%*// //%Q-.*,%-,* *,%%**,$ ,,,,,,,,,,
OL,3,AHundreds complain about I'm A Celebrity
OL,4,Aafter Mariella Frostrup called AJ Odudu
OL,5,A'aggressive'                           
OL,7,FThe pair were seen clearing the air on 
OL,8,FTuesday, with broadcaster Frostrup     
OL,9,Fsaying she was "sorry for calling you  
OL,10,Faggressive" and Odudu telling her it is
OL,11,F"a strong word to use in casual        
OL,12,Fscenarios, particularly towards black  
OL,13,Fwomen".                                
OL,23,APub: 25-NovQpppppppppppppppppppppG11/19
