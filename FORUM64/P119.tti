PN,11902
SC,0002
PS,C200
CT,10,T
OL,0,         GFORUM64   GDo 19 Nov F13:22:07
OL,1,T,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,,
OL,3,Gaktiviert ist, dann kann anhand vom    
OL,4,GWert in $d031 abgelesen werden auf     
OL,5,Gwelchen CPU Speedindex 0-15 das U64    
OL,6,Geingestellt ist. Jetzt habe ich das an 
OL,7,Geinem U64 Elite I mit Firmware 3.14d   
OL,8,Gund ein einem U64 Elite II mit Firmware
OL,9,G3.14e ausprobiert und bekomme als      
OL,10,GR}ckmeldung immer den Wert $8f bzw. 143
OL,11,GDezimal. D.h. ich gehe davon aus, ich  
OL,12,Gmache irgend etwas falsch. Aber was?   
OL,14,GHier ist mal der Code von mir: //U64   
OL,15,GTurbo Test                             
OL,17,G* = $1000                              
OL,19,Glda $df1d // 170 detect ultimate       
OL,20,Ghardware and uci cmp #$c9 // 173       
OL,21,GUltimate found ? beq _dturbo // 175 lda
OL,22,G#$0d // 177 no jsr $ffd2 // 179 print  
OL,23,G<cr> ldx #$00 // 182 _c109: lda _c268,x
OL,24,D]FForum64.de RSS feed            (2/3) 
