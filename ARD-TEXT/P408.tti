OL,3,U########T##############################
OL,4,FGebet                                  
OL,5,G                                       
OL,6,GHerr, unser Gott, du offenbarst u      
OL,7,Gns in der Bedr{ngnis                   
OL,8,Gdie Macht deines Erbarmens.            
OL,9,GVon dir empfing die heilige            
OL,10,GKatharina die Gnade,                   
OL,11,Gdas Martyrium zu bestehen.             
OL,12,GVon dir komme auch uns die Kraft,      
OL,13,Gin aller Not auf deine                 
OL,14,GHilfe zu vertrauen.                    
OL,15,G                                       
OL,16,GDarum bitten wir durch ihn,            
OL,17,GJesus Christus, unseren Herren.        
OL,18,GAmen.                                  
OL,19,G                                       
OL,20,G                                       
